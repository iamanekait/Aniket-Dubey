# ==============================================================================
# ENVIRONMENT VARIABLES & PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, .env.production, or any real secret values.
# ==============================================================================

# Google Gemini AI Advisory Assistant (Server-Side Only — NEVER prefix with VITE_)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Base Application URL
APP_URL="https://aniketdubey.com"

# ==============================================================================
# DISTRIBUTED RATE LIMITING (RECOMMENDED FOR VERCEL SERVERLESS)
# Uses Upstash Redis HTTP REST API across all serverless instances.
# Leave blank in local dev to use local in-memory rate-limiting fallback.
# Provision at: https://console.upstash.com/redis
# ==============================================================================
# UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN_HERE"

# ==============================================================================
# PRODUCTION EMAIL DISPATCH CONFIGURATION (DELIVERING TO email@aniketdubey.com)
# Configure ONE provider below in Vercel -> Project Settings -> Environment Variables.
# Keep all values strictly server-side (never expose with VITE_).
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: SMTP via Nodemailer (TLS >= 1.2 with strict certificate verification)
# For Google Workspace / Gmail, generate an App Password at:
# https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="YOUR_SMTP_USERNAME_HERE"
# SMTP_PASS="YOUR_SMTP_PASSWORD_OR_APP_PASSWORD_HERE"
# SMTP_FROM="\"Aniket Dubey Business Advisory\" <email@aniketdubey.com>"

# ------------------------------------------------------------------------------
# OPTION 2: Resend API (HTTPS Port 443)
# ------------------------------------------------------------------------------
# RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE"
# RESEND_FROM="Aniket Dubey Advisory <consulting@aniketdubey.com>"

# ------------------------------------------------------------------------------
# OPTION 3: Brevo / Sendinblue API (HTTPS Port 443)
# ------------------------------------------------------------------------------
# BREVO_API_KEY="YOUR_BREVO_API_KEY_HERE"
# BREVO_SENDER="email@aniketdubey.com"
