# ==============================================================================
# PRODUCTION EMAIL DISPATCH CONFIGURATION (FOR email@aniketdubey.com)
#
# Choose ONE of the following options and add the corresponding variables
# in your Vercel Project Settings -> Environment Variables.
#
# All options deliver consultation requests directly to email@aniketdubey.com
# with the prospect's email configured as the Reply-To address.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Resend API (RECOMMENDED for Vercel Serverless)
# Free 3,000 emails/month, 100 emails/day. Highly reliable HTTP API (Port 443).
# Get your API key at: https://resend.com/api-keys
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_123456789abcdef"
# RESEND_FROM="Aniket Dubey Advisory <consulting@aniketdubey.com>"
# (Note: Before domain verification, you can test with: "onboarding@resend.dev")

# ------------------------------------------------------------------------------
# OPTION 2: Brevo / Sendinblue API
# Free 300 emails/day. Reliable HTTP API (Port 443).
# Get your API key at: https://app.brevo.com/settings/keys/api
# ------------------------------------------------------------------------------
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxx"
# BREVO_SENDER="email@aniketdubey.com"

# ------------------------------------------------------------------------------
# OPTION 3: SendGrid API
# Free 100 emails/day.
# Get your API key at: https://app.sendgrid.com/settings/api_keys
# ------------------------------------------------------------------------------
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
# SENDGRID_FROM="email@aniketdubey.com"

# ------------------------------------------------------------------------------
# OPTION 4: Google Workspace or Gmail (App Password)
# If email@aniketdubey.com is hosted on Google Workspace or you use Gmail:
# 1. Enable 2-Step Verification on Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="email@aniketdubey.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="\"Aniket Dubey Business Advisory\" <email@aniketdubey.com>"

# ------------------------------------------------------------------------------
# OPTION 5: Custom Domain SMTP (Titan Mail, Hostinger, Zoho, GoDaddy, cPanel)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.titan.email"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER="email@aniketdubey.com"
# SMTP_PASS="YourMailboxPassword"
# SMTP_FROM="\"Aniket Dubey Business Advisory\" <email@aniketdubey.com>"
